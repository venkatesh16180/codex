# .env.example
CODEX_DB_PATH=data/librarian.db
CODEX_LIBRARIAN_MODEL=qwen3:4b
CODEX_CHAT_MODEL=llama3.2
CODEX_HISTORY_TURNS=3
CODEX_RELEVANCE_THRESHOLD=0.3
CODEX_NUM_CTX=8192
CODEX_LOG_LEVEL=INFO
CODEX_LOG_PATH=data/codex.log
# Read timeouts in seconds (a dead server is caught separately, by the connect timeout)
CODEX_LLM_TRIAGE_TIMEOUT_SEC=10800
CODEX_LLM_CHAT_TIMEOUT_SEC=420
CODEX_LLM_CONNECT_TIMEOUT_SEC=10
# Warn (never reject) when a document is larger than this many characters at ingestion
CODEX_MAX_CHARS_WARNING=500000
